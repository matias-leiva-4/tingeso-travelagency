# Plantilla de variables de entorno para docker compose.
# Copiar a ".env" y rellenar valores. El archivo .env NO se commitea (está en .gitignore).
#
# Uso:
#   cp .env.example .env
#   # editar .env con valores reales
#   docker compose up -d

# ─── Docker Hub ──────────────────────────────────────────────────────────
# Tu usuario de Docker Hub (para que el compose sepa de dónde bajar las imágenes)
DOCKERHUB_USER=tu-usuario-dockerhub

# ─── Base de datos ───────────────────────────────────────────────────────
# Password de PostgreSQL. En producción usa algo fuerte (mínimo 16 chars).
DB_PASSWORD=cambiar-esto-en-produccion

# ─── Keycloak ────────────────────────────────────────────────────────────
# Password del admin master de Keycloak (lo que usas en http://.../admin)
KEYCLOAK_ADMIN_PASSWORD=cambiar-esto-en-produccion

# Hostname público de Keycloak.
# Local:  keycloak                       (vía /etc/hosts)
# AWS:    54.123.45.67  o  midominio.com
KEYCLOAK_HOSTNAME=keycloak

# ─── CORS ────────────────────────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos por el backend.
# Local:  http://localhost:8070
# AWS:    http://54.123.45.67:8070
CORS_ALLOWED_ORIGINS=http://localhost:8070,http://127.0.0.1:8070
